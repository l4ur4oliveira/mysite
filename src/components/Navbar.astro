---
import * as AboutWork from "../content/about-and-work.md";
import * as Skills from "../content/skills.md";

import Sun from "phosphor-astro/Sun.astro";
import Moon from "phosphor-astro/Moon.astro";

export interface Props {
  isHome?: boolean;
  printHidden?: boolean;
}

const { isHome = false, printHidden = false } = Astro.props;

const prefix = isHome ? "" : "/";
const logoHref = isHome ? "#hero" : "/";

const links = [
  { href: `${prefix}#about`, label: AboutWork.frontmatter.title },
  { href: `${prefix}#skills`, label: Skills.frontmatter.title },
  { href: `${prefix}#posts`, label: "Posts" },
  { href: `${prefix}#contact`, label: "Contato" },
];

const konamiSequence = ["↑", "↑", "↓", "↓", "←", "→", "←", "→", "B", "A"];
---

<nav class:list={["fixed top-0 left-0 right-0 z-50 bg-black", printHidden && "print:hidden"]}>
  <div class="max-w-6xl m-auto px-6 py-6 flex items-center justify-between">
    <a href={logoHref} class="flex items-center gap-3">
      <img src="/logo-lauoliveira.svg" alt="Logo Laura" class="max-w-45 w-full mx-auto" />
    </a>
    <div class="hidden md:flex items-center gap-4 text-lime-400">
      <ul class="flex items-center gap-9 font-oxygen-mono">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="tracking-tighter hover:underline underline-offset-2">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button id="theme-toggle-desktop" class="p-2 ml-4 hover:text-white transition-colors outline-none cursor-pointer" aria-label="Toggle theme">
        <Sun class="w-6 h-6 hidden dark:block" />
        <Moon class="w-6 h-6 block dark:hidden" />
      </button>
    </div>
  </div>
  <input id="nav-toggle" type="checkbox" class="peer sr-only" />
  <label for="nav-toggle" class="md:hidden absolute right-16 top-6 cursor-pointer p-2 z-50" aria-label="Alternar menu de navegação">
    <span class="bar1 block w-6 h-0.5 bg-lime-400 mb-1" aria-hidden="true"></span>
    <span class="bar2 block w-6 h-0.5 bg-lime-400 mb-1" aria-hidden="true"></span>
    <span class="bar3 block w-6 h-0.5 bg-lime-400" aria-hidden="true"></span>
  </label>
  <ul id="mobile-menu" class="hidden peer-checked:flex md:hidden flex-col gap-2 px-6 pb-4 pt-2 bg-black text-lime-400 font-oxygen-mono">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="block py-2 hover:underline">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <button id="theme-toggle-mobile" class="md:hidden absolute right-4 top-5 cursor-pointer p-2 z-50 text-lime-400 hover:text-white transition-colors outline-none" aria-label="Toggle theme">
    <Sun class="w-6 h-6 hidden dark:block" />
    <Moon class="w-6 h-6 block dark:hidden" />
  </button>
</nav>

<div id="konami-tray" aria-hidden="true" class="fixed bottom-10 left-10 z-40 flex items-center gap-1 bg-black border border-teal-600/40 rounded-lg px-3 py-2 opacity-0 translate-y-2 pointer-events-none transition-all duration-300">
  {
    konamiSequence.map((label) => (
      <span data-konami-cell class="font-oxygen-mono text-sm w-6 h-6 flex items-center justify-center rounded border border-teal-600/40 text-teal-500 opacity-30 transition-all duration-200">{label}</span>
    ))
  }
</div>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    localStorage.setItem("theme", element.classList.contains("dark") ? "dark" : "light");
  };

  document.getElementById("theme-toggle-desktop")?.addEventListener("click", handleToggleClick);
  document.getElementById("theme-toggle-mobile")?.addEventListener("click", handleToggleClick);

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    if (localStorage.getItem("theme")) return;
    document.documentElement.classList.toggle("dark", e.matches);
  });

  // Close mobile checkbox menu on homepage
  (function () {
    const toggle = document.getElementById("nav-toggle") as HTMLInputElement;
    if (!toggle) return;

    const menuLinks = document.querySelectorAll('a[href^="#"]');
    menuLinks.forEach((link) =>
      link.addEventListener("click", () => {
        if (toggle.checked) toggle.checked = false;
      }),
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.checked) toggle.checked = false;
    });
  })();

  // Konami code easter egg 
  const KONAMI_KEYS = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "b",
    "a",
  ];
  const KONAMI_ACTIVE_CLASSES = [
    "text-lime-400",
    "border-lime-400",
    "opacity-100",
    "scale-110",
    "bg-lime-400/10",
  ];

  const konamiTray = document.getElementById("konami-tray");
  const konamiCells = Array.from(document.querySelectorAll("[data-konami-cell]"));

  let konamiIndex = 0;
  let konamiTimer: number | undefined;

  const resetKonami = () => {
    konamiIndex = 0;
    window.clearTimeout(konamiTimer);
    konamiCells.forEach((cell) => cell.classList.remove(...KONAMI_ACTIVE_CLASSES));
    konamiTray?.classList.remove("opacity-100", "translate-y-0", "scale-105");
    konamiTray?.classList.add("opacity-0", "translate-y-2");
  };

  document.addEventListener("keydown", (e) => {
    if (e.key === KONAMI_KEYS[konamiIndex]) {
      konamiIndex++;
      konamiCells[konamiIndex - 1]?.classList.add(...KONAMI_ACTIVE_CLASSES);
      konamiTray?.classList.remove("opacity-0", "translate-y-2");
      konamiTray?.classList.add("opacity-100", "translate-y-0");

      if (konamiIndex === KONAMI_KEYS.length) {
        konamiTray?.classList.add("scale-105", "border-lime-400");
        window.setTimeout(() => {
          if (!window.location.pathname.startsWith("/favorites")) {
            window.location.href = "/favorites";
          } else {
            resetKonami();
          }
        }, 500);
        return;
      }

      window.clearTimeout(konamiTimer);
      konamiTimer = window.setTimeout(resetKonami, 2000);
    } else {
      resetKonami();
    }
  });
</script>
