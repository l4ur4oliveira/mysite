---

<div class="hero-bg-container absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
  <svg
    viewBox="0 0 1920 951"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full object-cover opacity-30 transition-opacity duration-700"
    preserveAspectRatio="xMidYMid slice"
  >
    <!-- Subtle static base paths: 3 paths on mobile, full set on tablet/desktop -->
    <g class="hero-base-lines">
      {paths.map((d, index) => (
        <path
          d={d}
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={index >= 5 ? "hidden md:inline" : ""}
        />
      ))}
    </g>

    <!-- Animated glowing line pulses: 3 paths on mobile, full set on tablet/desktop -->
    <g class="hero-pulse-lines">
      {paths.map((d, index) => {
        const config = lineConfigs[index];
        return (
          <path
            d={d}
            pathLength="1000"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={index >= 5 ? "hidden md:inline" : ""}
            style={{
              "--flow-duration": config.duration,
              "--flow-delay": config.delay,
              "--flow-dash": config.dash,
            }}
          />
        );
      })}
    </g>
  </svg>
</div>

<style>
  .hero-bg-container {
    opacity: 0;
    animation: hero-bg-appear 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    contain: strict;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  @keyframes hero-bg-appear {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Base lines provide structural visibility */
  .hero-base-lines path {
    stroke: var(--color-lime-400);
    opacity: 0.16;
    transition: opacity 0.3s ease, stroke 0.3s ease;
  }

  :global(.dark) .hero-base-lines path {
    stroke: var(--color-lime-400);
    opacity: 0.22;
  }

  :global(:not(.dark)) .hero-base-lines path {
    stroke: #528696;
    opacity: 0.18;
  }

  /* Animated energy pulses (clean vector stroke with zero costly filter:drop-shadow) */
  .hero-pulse-lines path {
    stroke: var(--color-lime-400);
    stroke-dasharray: var(--flow-dash, 180 820);
    stroke-dashoffset: 1000;
    animation: flow-line var(--flow-duration, 12s) linear infinite;
    animation-delay: var(--flow-delay, 0s);
    opacity: 0.9;
  }

  @keyframes flow-line {
    from {
      stroke-dashoffset: 1000;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-container {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .hero-pulse-lines path {
      animation: none !important;
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 0.25 !important;
      filter: none !important;
    }
  }
</style>
